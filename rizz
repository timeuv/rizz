<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>The Ultimate Rizz Pitch 💜</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
  --purple: #b87dff;
  --lavender: #d4b0ff;
  --green: #c8f06e;
  --peach: #ffb997;
  --dark: #1a1025;
  --mid: #2e1f4a;
  --text: #f0e8ff;
}
* { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color: transparent; }
body {
  background: var(--dark);
  color: var(--text);
  font-family: 'Space Mono', monospace;
  overflow-x: hidden;
  cursor: none; /* ซ่อนเมาส์มาตรฐาน */
}
/* ปรับปรุง Cursor ให้ไม่บั๊กบนมือถือ */
.cursor {
  width:20px; height:20px;
  background: var(--purple);
  border-radius:50%;
  position:fixed; top:0; left:0;
  pointer-events:none; z-index:9999;
  transform:translate(-50%,-50%);
  transition:transform 0.08s;
  mix-blend-mode:screen;
}
@media (hover: none) and (pointer: coarse) {
  .cursor { display: none; } /* ซ่อนวงกลมบนมือถือ */
  body { cursor: auto; }
}

.slide {
  min-height:100vh; display:none;
  flex-direction:column; justify-content:center; align-items:center;
  padding:100px 24px 80px; position:relative; overflow:hidden;
  animation: fadeSlide 0.45s ease;
}
.slide.active { display:flex; }
@keyframes fadeSlide {
  from { opacity:0; transform:translateY(16px); }
  to   { opacity:1; transform:translateY(0); }
}
.slide::before {
  content:''; position:absolute; inset:0; pointer-events:none;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
  opacity:0.3;
}

/* topbar */
.topbar {
  position:fixed; top:0; left:0; right:0; z-index:200;
  display:flex; justify-content:flex-end; align-items:center;
  padding:12px 20px;
  background:rgba(26,16,37,0.7);
  backdrop-filter:blur(12px);
  border-bottom:1px solid rgba(255,255,255,0.05);
}
.lang-btn {
  background:rgba(184,125,255,0.12);
  border:1px solid rgba(184,125,255,0.35);
  color:var(--lavender);
  font-family:'Space Mono',monospace;
  font-size:10px; font-weight:700;
  letter-spacing:2px; text-transform:uppercase;
  padding:7px 16px; border-radius:30px;
  cursor: pointer; transition:all 0.2s;
}
.lang-btn:hover { background:rgba(184,125,255,0.25); box-shadow:0 0 18px rgba(184,125,255,0.3); }

/* progress + nav */
.progress {
  position:fixed; top:0; left:0; height:3px;
  background:linear-gradient(90deg,var(--purple),var(--green));
  transition:width 0.4s ease; z-index:1000;
}
.nav-dots {
  position:fixed; right:14px; top:50%;
  transform:translateY(-50%);
  display:flex; flex-direction:column; gap:9px; z-index:100;
}
.nav-dot {
  width:7px; height:7px; border-radius:50%;
  background:rgba(255,255,255,0.15);
  transition:all 0.3s; cursor: pointer;
}
.nav-dot.active { background:var(--purple); transform:scale(1.6); box-shadow:0 0 8px var(--purple); }
.nav-btn {
  background:rgba(255,255,255,0.05);
  border:1px solid rgba(255,255,255,0.1);
  color:rgba(255,255,255,0.45);
  width:44px; height:44px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  font-size:16px; cursor: pointer; transition:all 0.2s;
  position:fixed; bottom:24px; z-index:100;
}
.nav-btn:hover { background:rgba(255,255,255,0.1); color:white; }
.nav-btn:disabled { opacity:0.12; pointer-events:none; }
.nav-prev { left:24px; }
.nav-next { right:24px; }

/* shared */
.slide-label { font-size:9px; letter-spacing:4px; text-transform:uppercase; color:var(--purple); margin-bottom:13px; }
.slide-title { font-family:'Syne',sans-serif; font-size:clamp(28px,6.5vw,64px); font-weight:800; margin-bottom:26px; line-height:1.1; text-align:center; }

.btn-yes, .btn-no, .btn-start {
  border:none; font-family:'Space Mono',monospace;
  font-weight:700; border-radius:50px; cursor: pointer;
  letter-spacing:1.5px; text-transform:uppercase; transition:all 0.2s; margin:7px;
}
.btn-yes, .btn-start {
  background:var(--green); color:var(--dark);
  padding:15px 42px; font-size:13px;
  box-shadow:0 0 26px rgba(200,240,110,0.32);
}
.btn-yes:hover, .btn-start:hover { transform:scale(1.06); box-shadow:0 0 46px rgba(200,240,110,0.6); }
.btn-no {
  background:transparent; color:rgba(255,255,255,0.32);
  border:1px solid rgba(255,255,255,0.13);
  padding:15px 42px; font-size:13px;
}
.btn-no:hover { background:rgba(255,255,255,0.05); }

/* Animation Keyframes */
@keyframes pulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.04)} }
@keyframes wiggle { 0%,100%{transform:rotate(-6deg)} 50%{transform:rotate(6deg)} }
@keyframes float {
  from { transform:translateY(108vh) rotate(0deg); opacity:0.12; }
  to   { transform:translateY(-8vh) rotate(360deg); opacity:0; }
}
@keyframes pop { from{transform:scale(0);opacity:0} to{transform:scale(1);opacity:1} }
@keyframes glow {
  from{filter:drop-shadow(0 0 18px rgba(200,240,110,0.3))}
  to  {filter:drop-shadow(0 0 52px rgba(200,240,110,0.75))}
}

/* ---------- SLIDE 1 HERO ---------- */
#s1 {
  background:radial-gradient(ellipse at 20% 50%,#3b1a6e 0%,var(--dark) 60%),
             radial-gradient(ellipse at 80% 20%,#1f0d40 0%,transparent 50%);
  text-align:center;
}
.hero-badge {
  background:var(--green); color:var(--dark); font-size:10px; font-weight:700;
  letter-spacing:3px; padding:5px 16px; border-radius:20px; margin-bottom:26px;
  text-transform:uppercase; display:inline-block; animation:pulse 2s infinite;
}
.hero-title {
  font-family:'Syne',sans-serif; font-size:clamp(40px,12vw,122px);
  font-weight:800; line-height:0.88; letter-spacing:-3px; margin-bottom:18px;
  background:linear-gradient(135deg,#fff 0%,var(--lavender) 50%,var(--purple) 100%);
  -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
}
.hero-sub { font-size:clamp(12px,2vw,17px); color:var(--green); margin-bottom:10px; padding: 0 10px; }
.hero-sub2 { font-size:10px; color:rgba(255,255,255,0.32); font-style:italic; margin-bottom:42px; }
.floaters { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
.floater { position:absolute; font-size:24px; animation:float linear infinite; opacity:0.11; }

/* ---------- SLIDE 2 MARKET ---------- */
#s2 { background:linear-gradient(160deg,#0d0d1a 0%,#1a0d2e 50%,#0a1a0a 100%); }
.market-box {
  max-width:660px; width:90%;
  background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08);
  border-radius:22px; padding:30px; text-align:left; position:relative; overflow:hidden;
}
.market-headline { font-family:'Syne',sans-serif; font-size:20px; font-weight:800; color:var(--peach); margin-bottom:13px; }
.market-text { font-size:12px; line-height:1.8; color:rgba(255,255,255,0.56); margin-bottom:16px; }
.market-bold { color:var(--green); font-weight:700; font-size:13px; }
.tag { display:inline-block; background:rgba(184,125,255,0.1); border:1px solid rgba(184,125,255,0.26); color:var(--lavender); font-size:9px; padding:4px 11px; border-radius:20px; margin:3px; }

/* ---------- SLIDE 3 METRICS ---------- */
#s3 { background:radial-gradient(ellipse at 70% 30%,#1a0d2e 0%,#080812 70%); }
.metrics-container { width:90%; max-width:600px; }
.metric-row { margin-bottom:20px; opacity:0; transform:translateX(-16px); transition:all 0.5s ease; }
.metric-row.visible { opacity:1; transform:translateX(0); }
.metric-label { display:flex; justify-content:space-between; margin-bottom:7px; font-size:11px; color:rgba(255,255,255,0.62); }
.metric-pct { color:var(--green); font-weight:700; }
.metric-bar-bg { background:rgba(255,255,255,0.06); border-radius:50px; height:10px; overflow:hidden; }
.metric-bar { height:100%; border-radius:50px; width:0%; transition:width 1.3s cubic-bezier(0.23,1,0.32,1); }

/* ---------- SLIDE 4 GREEN FLAGS ---------- */
#s4 { background:linear-gradient(150deg,#0a1a0a 0%,#0d1a10 50%,#0d0d1a 100%); }
.flags-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:10px; max-width:760px; width:90%; margin-top:10px; }
.flag-card {
  background:rgba(200,240,110,0.04); border:1px solid rgba(200,240,110,0.14);
  border-radius:16px; padding:15px; text-align:center; transition:all 0.3s;
}
.flag-icon { font-size:24px; margin-bottom:8px; display:block; }
.flag-label { font-size:10px; color:var(--green); font-weight:700; margin-bottom:4px; }
.flag-desc { font-size:10px; color:rgba(255,255,255,0.43); line-height:1.5; }

/* ---------- SLIDE TIERS & OTHERS ---------- */
.tiers-row { display:flex; gap:14px; max-width:800px; width:90%; margin-top:22px; flex-wrap:wrap; justify-content:center; }
.tier-card { flex:1; min-width:220px; border-radius:20px; padding:26px 20px; text-align:center; border:1px solid; transition:all 0.3s; }
.tier-name { font-family:'Syne',sans-serif; font-size:38px; margin-bottom:8px; display:block; }
.tier-label { font-family:'Syne',sans-serif; font-size:16px; font-weight:800; margin-bottom:6px; }
.tier-feature { font-size:11px; color:rgba(255,255,255,0.52); line-height:1.8; text-align:left; }

/* Responsive Adjustments */
@media(max-width:600px){
  .nav-dots{display:none;}
  .slide-title { font-size: 28px; }
  .btn-yes, .btn-no, .btn-start { padding: 12px 24px; font-size: 11px; }
  .tier-card { min-width: 100%; }
  .topbar { justify-content: center; }
}

/* เพิ่มเติม CSS สำหรับความสวยงามที่ขาดหายไปจากโค้ดเดิมบางส่วนเพื่อให้รันได้จบในไฟล์เดียว */
.compare-table { width:90%; max-width:680px; border-collapse:collapse; margin-top:10px; font-size: 11px; }
.compare-table th { padding:10px; border-bottom:2px solid rgba(255,255,255,0.1); text-align: left; }
.compare-table td { padding:10px; border-bottom:1px solid rgba(255,255,255,0.05); }
.faq-list { width: 90%; max-width: 600px; }
.faq-item { background: rgba(255,255,255,0.03); padding: 15px; border-radius: 12px; margin-bottom: 10px; }
.roadmap { width: 90%; max-width: 500px; }
.road-step { display: flex; gap: 15px; margin-bottom: 15px; opacity: 0; transform: translateX(-20px); transition: 0.5s; }
.road-step.visible { opacity: 1; transform: translateX(0); }
.step-num { width:30px; height:30px; background:var(--purple); border-radius:8px; display:flex; align-items:center; justify-content:center; font-weight:800; flex-shrink:0; }
</style>
</head>
<body>

<div class="cursor" id="cursor"></div>
<div class="progress" id="progress"></div>

<div class="topbar">
  <button class="lang-btn" id="langBtn" onclick="toggleLang()">🇹🇭 ภาษาไทย</button>
</div>

<div class="nav-dots" id="navDots"></div>
<button class="nav-btn nav-prev" id="prevBtn" onclick="changeSlide(-1)">←</button>
<button class="nav-btn nav-next" id="nextBtn" onclick="changeSlide(1)">→</button>

<div class="slide active" id="s1">
  <div class="floaters" id="floaters"></div>
  <div class="hero-badge" data-en="🔥 Limited Edition Offer · Season 2025" data-th="🔥 ออฟเฟอร์พิเศษ · Season 2025">🔥 Limited Edition Offer · Season 2025</div>
  <h1 class="hero-title">THE ULTIMATE<br>RIZZ PITCH</h1>
  <p class="hero-sub" data-en="Why dating me is the only W you need this year." data-th="ทำไมการคบฉันถึงเป็น W เดียวที่แกต้องการปีนี้">Why dating me is the only W you need this year.</p>
  <button class="btn-start" onclick="changeSlide(1)" data-en="Let's go 🚀" data-th="ไปเลย 🚀">Let's go 🚀</button>
</div>

<script>
// จัดการ Cursor
const cursor = document.getElementById('cursor');
document.addEventListener('mousemove', e => {
  cursor.style.left = e.clientX + 'px';
  cursor.style.top = e.clientY + 'px';
});

// จัดการภาษา
let lang = 'en';
function toggleLang() {
  lang = lang === 'en' ? 'th' : 'en';
  document.getElementById('langBtn').textContent = lang === 'en' ? '🇹🇭 ภาษาไทย' : '🇬🇧 English';
  document.querySelectorAll('[data-en]').forEach(el => {
    const v = el.getAttribute('data-' + lang);
    if (v) el.innerHTML = v;
  });
}

// ระบบเลื่อน Slide
const mainIds = ['s1','s2','s3','s4','s5','s6','s7','s8','s9','s10','s11','s12'];
let cur = 0;

function updateUI() {
  const pct = ((cur + 1) / mainIds.length) * 100;
  document.getElementById('progress').style.width = pct + '%';
  document.getElementById('prevBtn').disabled = cur === 0;
  document.getElementById('nextBtn').disabled = cur >= mainIds.length - 1;
}

function goTo(i) {
  if (i < 0 || i >= mainIds.length) return;
  document.querySelectorAll('.slide').forEach(s => s.classList.remove('active'));
  cur = i;
  const target = document.getElementById(mainIds[i]);
  if(target) target.classList.add('active');
  updateUI();
}

function changeSlide(dir) { goTo(cur + dir); }

// เรียกใช้แอนิเมชั่นลอยๆ ในหน้าแรก
const fe = ['💜','✨','🔥','💫','🌟','💅','🐐','💯'];
const fc = document.getElementById('floaters');
for (let i = 0; i < 10; i++) {
  const el = document.createElement('div');
  el.className = 'floater';
  el.textContent = fe[Math.floor(Math.random()*fe.length)];
  el.style.cssText = `left:${Math.random()*100}%;animation-duration:${8+Math.random()*10}s;animation-delay:${Math.random()*5}s;`;
  fc.appendChild(el);
}

updateUI();
</script>
</body>
</html>
